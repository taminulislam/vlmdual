checkpoints/
checkpoints_*/
*.pt
*.pth
*.ckpt
*.safetensors

# === HuggingFace model cache ===
hf_cache/
.cache/

# === Results — track CSVs/JSON/TEX, skip large npz binaries ===
results/
results_*/
*.npz

# === SLURM / job logs ===
jobs/logs/
jobs/logs_*/
slurm-*.out
slurm-*.err
*.out
*.err

# === Augmentation logs ===
logs/

# === Wandb ===
wandb/
**/wandb/

